{
  "name": "@threevl/hpo-api",
  "version": "0.0.2",
  "description": "Standalone HTTP server for the Human Phenotype Ontology REST API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3VLINC/human-phenotype-docker.git",
    "directory": "packages/hpo-api"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hpo-api": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@threevl/hpo-express": "^0.0.2",
    "@threevl/hpo-lib": "^0.0.2",
    "express": "^4.21.0",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/swagger-ui-express": "^4.1.6"
  }
}
