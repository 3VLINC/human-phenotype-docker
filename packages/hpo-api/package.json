{
  "name": "@threevl/hpo-api",
  "version": "1.0.0",
  "description": "Standalone HTTP server for the Human Phenotype Ontology REST API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hpo-api": "dist/index.js"
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@threevl/hpo-express": "^1.0.0",
    "@threevl/hpo-lib": "^1.0.0",
    "express": "^4.21.0",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/swagger-ui-express": "^4.1.6"
  }
}
