FROM node:22-slim AS builder

WORKDIR /app

COPY api-node/package.json api-node/package-lock.json* ./
RUN npm ci

COPY api-node/tsconfig.json ./
COPY api-node/src ./src
RUN npm run build

FROM node:22-slim

WORKDIR /app

COPY api-node/package.json api-node/package-lock.json* ./
RUN npm ci --omit=dev

COPY --from=builder /app/dist ./dist

RUN mkdir -p /data

EXPOSE 8000

CMD ["node", "dist/server.js"]
